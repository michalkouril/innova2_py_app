#!/bin/sh
# SPDX-FileCopyrightText: 2026 the innova2 contributors
#
# SPDX-License-Identifier: Apache-2.0
set -e

if [ "$1" = configure ]; then
    # An earlier install.sh install puts its links in /usr/local/bin, which comes first in PATH.
    for l in innova2_app innova2_areg; do
        if [ -L /usr/local/bin/$l ]; then
            echo "note: /usr/local/bin/$l (from install.sh) shadows this package's /usr/bin/$l." >&2
            echo "      Remove the old install with: sudo rm -f /usr/local/bin/$l; sudo rm -rf /opt/innova2_app" >&2
            echo "      (not install.sh --uninstall: it would also remove the DKMS module this package uses)." >&2
        fi
    done
fi

#DEBHELPER#

exit 0
